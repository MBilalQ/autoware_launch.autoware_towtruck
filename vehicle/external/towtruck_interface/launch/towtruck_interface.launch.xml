<launch>
  <arg name="launch_serial_reader" default="true"/>
  <arg name="launch_vehicle_kinematics" default="true"/>
  <arg name="launch_localization_bridge" default="true"/>
  <arg name="launch_odometry_publisher" default="true"/>
  <arg name="launch_autoware_control" default="true"/>

  <!-- ============================= -->
  <!-- Serial Reader (Arduino I/O) -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="serial_reader.py"
    name="serial_reader"
    output="screen"
    if="$(var launch_serial_reader)"
  />

  <!-- ============================= -->
  <!-- Vehicle Kinematics -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="vehicle_kinematics.py"
    name="vehicle_kinematics"
    output="screen"
    if="$(var launch_vehicle_kinematics)"
  />

  <!-- ============================= -->
  <!-- Localization Bridge -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="localization_bridge.py"
    name="localization_bridge"
    output="screen"
    if="$(var launch_localization_bridge)"
  />

  <!-- ============================= -->
  <!-- Odometry + TF + Vehicle Status -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="autoware_odometry_publisher.py"
    name="autoware_odometry_publisher"
    output="screen"
    if="$(var launch_odometry_publisher)"
  />

  <!-- ============================= -->
  <!-- Autoware Control to Arduino -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="autoware_control.py"
    name="autoware_control"
    output="screen"
    if="$(var launch_autoware_control)"
  />

</launch>
