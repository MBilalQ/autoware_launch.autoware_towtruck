<launch>

  <!-- livox_to_autoware now runs as a C++ composable node loaded into
       pointcloud_container (see autoware_towtruck_sensor_kit_launch/launch/
       lidar.launch.py). Removed from this launch file. -->

  <!-- ============================= -->
  <!-- Serial Reader (Arduino I/O) -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="serial_reader.py"
    name="serial_reader"
    output="screen"
  />

  <!-- ============================= -->
  <!-- Vehicle Kinematics -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="vehicle_kinematics.py"
    name="vehicle_kinematics"
    output="screen"
  />

  <!-- ============================= -->
  <!-- Odometry + TF + Vehicle Status -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="autoware_odometry_publisher.py"
    name="autoware_odometry_publisher"
    output="screen"
  />

  <!-- ============================= -->
  <!-- Autoware Control to Arduino -->
  <!-- ============================= -->
  <node
    pkg="towtruck_interface"
    exec="autoware_control.py"
    name="autoware_control"
    output="screen"
  />

  <node
    pkg="towtruck_interface"
    exec="dummy_perception_publisher.py"
    name="dummy_perception_publisher"
    output="screen"
  />

</launch>
