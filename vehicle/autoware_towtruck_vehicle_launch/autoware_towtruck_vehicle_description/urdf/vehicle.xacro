<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="basic_mobile_bot">

  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find autoware_towtruck_vehicle_description)/config/vehicle_info.param.yaml')}"/>

  <!-- geometric constants (m) -->
  <xacro:property name="body_length" value="1.52"/>
  <xacro:property name="body_width" value="0.79"/>
  <xacro:property name="body_height" value="1.83"/>
  <xacro:property name="body_x_centre" value="0.435"/>   <!-- (-rear_overhang + body_length/2) = -0.325 + 0.76 -->
  <xacro:property name="body_z_centre" value="0.915"/>   <!-- body box spans z = 0 .. 1.83 (absorbs 0.07 ground clearance) -->

  <xacro:property name="rear_wheel_radius" value="0.195"/>
  <xacro:property name="rear_wheel_width" value="0.095"/>
  <xacro:property name="rear_wheel_y" value="0.3475"/>   <!-- wheel_tread/2 = 0.695/2 -->

  <xacro:property name="front_wheel_radius" value="0.12"/>
  <xacro:property name="front_wheel_width" value="0.24"/>
  <xacro:property name="front_wheel_x" value="0.995"/>   <!-- wheel_base -->

  <xacro:property name="max_steer" value="0.9774"/>

  <!-- mirror geometry & placement -->
  <xacro:property name="mirror_x" value="0.12"/>
  <xacro:property name="mirror_y" value="0.01"/>
  <xacro:property name="mirror_z" value="0.20"/>
  <xacro:property name="mirror_centre_x" value="1.067"/>
  <xacro:property name="mirror_centre_y" value="0.635"/>
  <xacro:property name="mirror_centre_z" value="1.51"/>

  <link name="base_link"/>

  <!-- chassis (body box) -->
  <link name="chassis_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="500.0"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0" iyy="100.0" iyz="0.0" izz="100.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="Red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="${body_x_centre} 0 ${body_z_centre}" rpy="0 0 0"/>
  </joint>

  <!-- rear wheels (drive, no steering) -->
  <xacro:macro name="rear_wheel" params="prefix y_reflect">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${rear_wheel_radius}" length="${rear_wheel_width}"/>
        </geometry>
        <material name="White">
          <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="0 ${y_reflect * rear_wheel_y} ${rear_wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel prefix="drivewhl_l" y_reflect="1"/>
  <xacro:rear_wheel prefix="drivewhl_r" y_reflect="-1"/>

  <!-- front single (dual-modelled) steering wheel -->
  <link name="steering_link"/>

  <joint name="steering_joint" type="fixed">
    <parent link="base_link"/>
    <child link="steering_link"/>
    <origin xyz="${front_wheel_x} 0 ${front_wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="front_steering_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/>
      </geometry>
      <material name="White">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="front_steering_wheel_joint" type="revolute">
    <parent link="steering_link"/>
    <child link="front_steering_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <limit upper="${max_steer}" lower="${-max_steer}" effort="10" velocity="1.0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- mirrors -->
  <xacro:macro name="mirror_panel" params="prefix y_reflect">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${mirror_x} ${mirror_y} ${mirror_z}"/>
        </geometry>
        <material name="Grey">
          <color rgba="0.4 0.4 0.4 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${mirror_x} ${mirror_y} ${mirror_z}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <!-- TODO verify mirror X — assumes mirror face aligns with sloped body front at mirror mid-height -->
      <origin xyz="${mirror_centre_x} ${y_reflect * mirror_centre_y} ${mirror_centre_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:mirror_panel prefix="mirror_left" y_reflect="1"/>
  <xacro:mirror_panel prefix="mirror_right" y_reflect="-1"/>

</robot>
