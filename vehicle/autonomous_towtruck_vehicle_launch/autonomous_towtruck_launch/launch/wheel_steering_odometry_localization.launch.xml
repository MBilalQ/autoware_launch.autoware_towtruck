<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" default="$(env AUTOWARE_MAP_PATH /home/efs/autoware_towtruck/autoware_map/projects_lab)"/>
  <arg name="vehicle_model" default="autonomous_towtruck"/>
  <arg name="sensor_model" default="autoware_towtruck_sensor_kit"/>
  <arg name="data_path" default="$(env HOME)/autoware_data"/>
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="/workspace/src/launcher/autoware_launch/autoware_launch/rviz/wheel_steering_only.rviz"/>
  <arg name="rviz_respawn" default="true"/>
  <arg name="launch_sensing" default="true"/>
  <arg
    name="launch_mid360_imu_relay"
    default="true"
    description="Relay the Livox MID360 IMU to Autoware's standard IMU topic for gyro odometry."
  />
  <arg
    name="publish_mid360_legacy_imu_tf"
    default="true"
    description="Publish livox_mid360 -> livox_frame identity TF for Livox driver builds that stamp IMU with the legacy livox_frame."
  />
  <arg name="mid360_imu_topic" default="/sensing/lidar/top/livox/imu"/>
  <arg name="localization_imu_topic" default="/sensing/imu/imu_data"/>
  <arg name="localization_input_pointcloud" default="/sensing/lidar/concatenated/pointcloud"/>
  <arg name="launch_path_corridor_obstacle_detector" default="true"/>
  <arg name="planning_validator_use_obstacle_pointcloud" default="true"/>
  <arg name="obstacle_map_pointcloud_topic" default="/map/pointcloud_map"/>
  <arg name="obstacle_trajectory_topic" default="/planning/trajectory"/>
  <arg name="obstacle_fallback_trajectory_topic" default="/planning/scenario_planning/trajectory"/>
  <arg name="obstacle_path_corridor_width" default="0.8"/>
  <arg name="obstacle_path_corridor_margin" default="0.05"/>
  <arg name="obstacle_height_threshold" default="0.09"/>
  <arg name="obstacle_min_forward_distance" default="0.5"/>
  <arg name="obstacle_min_corridor_points" default="4"/>
  <arg name="obstacle_detection_hold_time_sec" default="0.25"/>
  <arg name="obstacle_max_detection_range" default="10.0"/>
  <arg name="obstacle_output_publish_rate" default="20.0"/>
  <arg name="planning_module_preset" default="wheel_steering_route_planning"/>
  <arg name="control_module_preset" default="wheel_steering_only"/>
  <arg
    name="control_module_preset_file"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/control/preset/wheel_steering_only_preset.yaml"
  />
  <arg
    name="planning_module_preset_file"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/preset/wheel_steering_route_planning_preset.yaml"
  />
  <arg
    name="path_generator_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/scenario_planning/lane_driving/behavior_planning/path_generator/wheel_steering_only.param.yaml"
  />
  <arg
    name="behavior_path_planner_common_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/wheel_steering_only.param.yaml"
  />
  <arg
    name="behavior_path_planner_drivable_area_expansion_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner/wheel_steering_only_drivable_area_expansion.param.yaml"
  />
  <arg
    name="path_optimizer_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/scenario_planning/lane_driving/motion_planning/autoware_path_optimizer/wheel_steering_only.param.yaml"
  />
  <arg
    name="scenario_selector_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/scenario_planning/common/scenario_selector/wheel_steering_only.param.yaml"
  />
  <arg
    name="shift_decider_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/control/shift_decider/wheel_steering_only.param.yaml"
  />
  <arg
    name="launch_dummy_operation_mode_publisher"
    default="false"
    description="Keep the fake operation mode publisher disabled when the real system stack is running."
  />
  <arg
    name="launch_dummy_mrm_state_publisher"
    default="true"
  />
  <arg name="localization_pose_source" default="ndt"/>
  <arg name="localization_twist_source" default="gyro_odom"/>
  <arg
    name="localization_gnss_enabled"
    default="false"
    description="Keep false for LiDAR + wheel odometry + MID360 IMU localization unless GNSS is available."
  />

  <include file="$(find-pkg-share autonomous_towtruck_launch)/launch/wheel_steering_only.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
    <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="rviz_config" value="$(var rviz_config)"/>
    <arg name="rviz_respawn" value="$(var rviz_respawn)"/>
    <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
    <arg name="control_module_preset" value="$(var control_module_preset)"/>
    <arg name="control_module_preset_file" value="$(var control_module_preset_file)"/>
    <arg name="planning_module_preset_file" value="$(var planning_module_preset_file)"/>
    <arg name="launch_sensing" value="$(var launch_sensing)"/>
    <arg name="launch_sensing_driver" value="true"/>
    <arg name="launch_sensing_imu_driver" value="false"/>
    <arg name="launch_localization" value="true"/>
    <arg name="localization_pose_source" value="$(var localization_pose_source)"/>
    <arg name="localization_twist_source" value="$(var localization_twist_source)"/>
    <arg name="localization_gnss_enabled" value="$(var localization_gnss_enabled)"/>
    <arg name="localization_input_pointcloud" value="$(var localization_input_pointcloud)"/>
    <arg
      name="launch_path_corridor_obstacle_detector"
      value="$(var launch_path_corridor_obstacle_detector)"
    />
    <arg
      name="planning_validator_use_obstacle_pointcloud"
      value="$(var planning_validator_use_obstacle_pointcloud)"
    />
    <arg name="obstacle_map_pointcloud_topic" value="$(var obstacle_map_pointcloud_topic)"/>
    <arg name="obstacle_trajectory_topic" value="$(var obstacle_trajectory_topic)"/>
    <arg
      name="obstacle_fallback_trajectory_topic"
      value="$(var obstacle_fallback_trajectory_topic)"
    />
    <arg name="obstacle_path_corridor_width" value="$(var obstacle_path_corridor_width)"/>
    <arg name="obstacle_path_corridor_margin" value="$(var obstacle_path_corridor_margin)"/>
    <arg name="obstacle_height_threshold" value="$(var obstacle_height_threshold)"/>
    <arg name="obstacle_min_forward_distance" value="$(var obstacle_min_forward_distance)"/>
    <arg name="obstacle_min_corridor_points" value="$(var obstacle_min_corridor_points)"/>
    <arg
      name="obstacle_detection_hold_time_sec"
      value="$(var obstacle_detection_hold_time_sec)"
    />
    <arg name="obstacle_max_detection_range" value="$(var obstacle_max_detection_range)"/>
    <arg name="obstacle_output_publish_rate" value="$(var obstacle_output_publish_rate)"/>
    <arg name="path_generator_param_path" value="$(var path_generator_param_path)"/>
    <arg
      name="behavior_path_planner_common_param_path"
      value="$(var behavior_path_planner_common_param_path)"
    />
    <arg
      name="behavior_path_planner_drivable_area_expansion_param_path"
      value="$(var behavior_path_planner_drivable_area_expansion_param_path)"
    />
    <arg name="path_optimizer_param_path" value="$(var path_optimizer_param_path)"/>
    <arg name="scenario_selector_param_path" value="$(var scenario_selector_param_path)"/>
    <arg name="shift_decider_param_path" value="$(var shift_decider_param_path)"/>
    <arg
      name="component_state_monitor_topic_path"
      value="/workspace/src/launcher/autoware_launch/autoware_launch/config/system/component_state_monitor/wheel_steering_only_topics.yaml"
    />
    <arg
      name="diagnostic_graph_aggregator_graph_path"
      value="/workspace/src/launcher/autoware_launch/autoware_launch/config/system/diagnostics/autoware-wheel-steering-only.yaml"
    />
    <arg name="launch_vehicle_serial_reader" value="true"/>
    <arg name="launch_vehicle_kinematics" value="true"/>
    <arg name="launch_control_kinematics_simulator" value="false"/>
    <arg name="launch_vehicle_localization_bridge" value="false"/>
    <arg name="launch_vehicle_odometry_publisher" value="true"/>
    <arg name="launch_vehicle_control_interface" value="true"/> # was true 
    <arg
      name="launch_dummy_operation_mode_publisher"
      value="$(var launch_dummy_operation_mode_publisher)"
    />
    <arg
      name="launch_dummy_mrm_state_publisher"
      value="$(var launch_dummy_mrm_state_publisher)"
    />
  </include>

  <node
    if="$(var launch_mid360_imu_relay)"
    pkg="topic_tools"
    exec="relay"
    name="mid360_imu_relay"
    output="log">
    <param name="input_topic" value="$(var mid360_imu_topic)"/>
    <param name="output_topic" value="$(var localization_imu_topic)"/>
    <param name="type" value="sensor_msgs/msg/Imu"/>
    <param name="reliability" value="best_effort"/>
  </node>

  <node
    if="$(var publish_mid360_legacy_imu_tf)"
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="livox_mid360_legacy_imu_tf"
    args="0 0 0 0 0 0 livox_mid360 livox_frame"
    output="log"/>
</launch>
