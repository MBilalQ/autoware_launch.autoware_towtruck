<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" default="$(env AUTOWARE_MAP_PATH /home/efs/autoware_towtruck/autoware_map/projects_lab)" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="autonomous_towtruck"/>
  <arg name="sensor_model" default="autoware_towtruck_sensor_kit"/>
  <arg name="data_path" default="$(env HOME)/autoware_data"/>
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="/workspace/src/launcher/autoware_launch/autoware_launch/rviz/wheel_steering_only.rviz"/>
  <arg name="rviz_respawn" default="true"/>
  <arg name="planning_module_preset" default="route_planning"/>
  <arg name="control_module_preset" default="wheel_steering_only"/>
  <arg
    name="control_module_preset_file"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/control/preset/wheel_steering_only_preset.yaml"
  />
  <arg
    name="planning_module_preset_file"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/preset/route_planning_preset.yaml"
  />
  <arg
    name="path_generator_param_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/planning/scenario_planning/lane_driving/behavior_planning/path_generator/wheel_steering_only.param.yaml"
  />
  <arg name="launch_system" default="true"/>
  <arg name="launch_sensing" default="false"/>
  <arg name="launch_control" default="true"/>
  <arg name="launch_system_monitor" default="false"/>
  <arg name="launch_dummy_diag_publisher" default="true"/>
  <arg
    name="component_state_monitor_topic_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/system/component_state_monitor/wheel_steering_only_topics.yaml"
  />
  <arg
    name="diagnostic_graph_aggregator_graph_path"
    default="/workspace/src/launcher/autoware_launch/autoware_launch/config/system/diagnostics/autoware-wheel-steering-only.yaml"
  />
  <arg name="enable_all_modules_auto_mode" default="true"/>
  <arg name="launch_vehicle_serial_reader" default="true"/>
  <arg name="launch_vehicle_kinematics" default="true"/>
  <arg name="launch_vehicle_localization_bridge" default="true"/>
  <arg name="launch_vehicle_odometry_publisher" default="true"/>
  <arg name="launch_vehicle_control_interface" default="true"/>
  <arg name="launch_dummy_obstacle_pointcloud_publisher" default="true"/>
  <arg name="launch_dummy_mrm_state_publisher" default="false"/>
  <arg
    name="launch_dummy_operation_mode_publisher"
    default="false"
    description="Publish a fake operation mode state. Keep disabled when the real system stack is running."
  />
  <arg
    name="launch_lidar_obstacle_pointcloud_relay"
    default="false"
    description="Relay a live LiDAR pointcloud into /perception/obstacle_segmentation/pointcloud for planning/control."
  />
  <arg
    name="lidar_obstacle_pointcloud_topic"
    default="/sensing/lidar/concatenated/pointcloud"
    description="Input LiDAR PointCloud2 topic to relay when launch_lidar_obstacle_pointcloud_relay is true."
  />
  <arg
    name="vehicle_localization_z_override"
    default="-1.8542"
    description="Overrides map->base_link z for dead-reckoning localization. Tune per map if the vehicle floats above or sinks below the ground plane."
  />

  <set_parameter name="map_z_override" value="$(var vehicle_localization_z_override)"/>

  <include file="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
    <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
    <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
    <arg name="planning_module_preset_file" value="$(var planning_module_preset_file)"/>
    <arg name="control_module_preset" value="$(var control_module_preset)"/>
    <arg name="control_module_preset_file" value="$(var control_module_preset_file)"/>
    <arg name="path_generator_param_path" value="$(var path_generator_param_path)"/>
    <arg name="launch_system" value="$(var launch_system)"/>
    <arg name="launch_sensing" value="$(var launch_sensing)"/>
    <arg name="launch_localization" value="false"/>
    <arg name="launch_perception" value="false"/>
    <arg name="launch_control" value="$(var launch_control)"/>
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="launch_vehicle_serial_reader" value="$(var launch_vehicle_serial_reader)"/>
    <arg name="launch_vehicle_kinematics" value="$(var launch_vehicle_kinematics)"/>
    <arg name="launch_vehicle_localization_bridge" value="$(var launch_vehicle_localization_bridge)"/>
    <arg name="launch_vehicle_odometry_publisher" value="$(var launch_vehicle_odometry_publisher)"/>
    <arg name="launch_vehicle_control_interface" value="$(var launch_vehicle_control_interface)"/>
    <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
    <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
    <arg name="component_state_monitor_topic_path" value="$(var component_state_monitor_topic_path)"/>
    <arg name="diagnostic_graph_aggregator_graph_path" value="$(var diagnostic_graph_aggregator_graph_path)"/>
    <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="rviz_config" value="$(var rviz_config)"/>
    <arg name="rviz_respawn" value="$(var rviz_respawn)"/>
  </include>

  <node
    pkg="autoware_dummy_perception_publisher"
    exec="empty_objects_publisher"
    name="empty_objects_publisher"
    output="screen">
    <remap from="~/output/objects" to="/perception/object_recognition/objects"/>
  </node>

  <node
    pkg="towtruck_interface"
    exec="empty_occupancy_grid_publisher.py"
    name="empty_occupancy_grid_publisher"
    output="screen">
    <param name="frame_id" value="map"/>
    <param name="topic_name" value="/perception/occupancy_grid_map/map"/>
    <param name="publish_rate" value="1.0"/>
    <param name="resolution" value="5.0"/>
    <param name="width" value="400"/>
    <param name="height" value="400"/>
    <param name="origin_x" value="-1000.0"/>
    <param name="origin_y" value="-1000.0"/>
    <param name="origin_z" value="0.0"/>
  </node>

  <node
    if="$(var launch_dummy_obstacle_pointcloud_publisher)"
    pkg="towtruck_interface"
    exec="empty_obstacle_pointcloud_publisher.py"
    name="empty_obstacle_pointcloud_publisher"
    output="screen">
    <param name="frame_id" value="base_link"/>
    <param name="topic_name" value="/perception/obstacle_segmentation/pointcloud"/>
    <param name="publish_rate" value="10.0"/>
  </node>

  <node
    if="$(var launch_lidar_obstacle_pointcloud_relay)"
    pkg="topic_tools"
    exec="relay"
    name="lidar_obstacle_pointcloud_relay"
    output="screen">
    <param name="input_topic" value="$(var lidar_obstacle_pointcloud_topic)"/>
    <param name="output_topic" value="/perception/obstacle_segmentation/pointcloud"/>
  </node>

  <node
    if="$(var launch_dummy_operation_mode_publisher)"
    pkg="towtruck_interface"
    exec="dummy_operation_mode_publisher.py"
    name="dummy_operation_mode_publisher"
    output="screen">
    <param name="publish_rate" value="2.0"/>
    <param name="publish_system_topic" value="true"/>
    <param name="publish_api_topic" value="true"/>
    <param name="mode" value="2"/>
    <param name="is_autoware_control_enabled" value="true"/>
    <param name="is_in_transition" value="false"/>
    <param name="is_stop_mode_available" value="true"/>
    <param name="is_autonomous_mode_available" value="true"/>
    <param name="is_local_mode_available" value="false"/>
    <param name="is_remote_mode_available" value="false"/>
  </node>

  <node
    if="$(var launch_dummy_mrm_state_publisher)"
    pkg="towtruck_interface"
    exec="dummy_mrm_state_publisher.py"
    name="dummy_mrm_state_publisher"
    output="screen">
    <param name="publish_rate" value="10.0"/>
    <param name="topic_name" value="/system/fail_safe/mrm_state"/>
    <param name="state" value="1"/>
    <param name="behavior" value="1"/>
  </node>
</launch>
