<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:include filename="$(find livox_description)/urdf/livox_horizon.xacro"/>
    <xacro:arg name="config_dir" default="$(find autoware_towtruck_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}"/>

    <xacro:livox_horizon_macro
      name="livox_mid360"
      parent="sensor_kit_base_link"
      x="${calibration['sensor_kit_base_link']['livox_mid360_base_link']['x']}"
      y="${calibration['sensor_kit_base_link']['livox_mid360_base_link']['y']}"
      z="${calibration['sensor_kit_base_link']['livox_mid360_base_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['livox_mid360_base_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['livox_mid360_base_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['livox_mid360_base_link']['yaw']}"
    />
  </xacro:macro>
</robot>
