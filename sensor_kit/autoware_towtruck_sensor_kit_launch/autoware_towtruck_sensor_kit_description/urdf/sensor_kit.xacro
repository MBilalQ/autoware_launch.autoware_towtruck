<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">

    <xacro:arg name="config_dir" default="$(find autoware_towtruck_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}"/>

    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <!-- Livox MID-360 LiDARs — keep legacy `velodyne_*_base_link` frame names so
         downstream rviz/localization configs don't need edits. -->
    <link name="velodyne_left_base_link"/>
    <joint name="velodyne_left_base_link_joint" type="fixed">
      <parent link="sensor_kit_base_link"/>
      <child link="velodyne_left_base_link"/>
      <origin
        xyz="${calibration['sensor_kit_base_link']['velodyne_left_base_link']['x']}
             ${calibration['sensor_kit_base_link']['velodyne_left_base_link']['y']}
             ${calibration['sensor_kit_base_link']['velodyne_left_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['velodyne_left_base_link']['roll']}
             ${calibration['sensor_kit_base_link']['velodyne_left_base_link']['pitch']}
             ${calibration['sensor_kit_base_link']['velodyne_left_base_link']['yaw']}"/>
    </joint>

    <link name="velodyne_right_base_link"/>
    <joint name="velodyne_right_base_link_joint" type="fixed">
      <parent link="sensor_kit_base_link"/>
      <child link="velodyne_right_base_link"/>
      <origin
        xyz="${calibration['sensor_kit_base_link']['velodyne_right_base_link']['x']}
             ${calibration['sensor_kit_base_link']['velodyne_right_base_link']['y']}
             ${calibration['sensor_kit_base_link']['velodyne_right_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['velodyne_right_base_link']['roll']}
             ${calibration['sensor_kit_base_link']['velodyne_right_base_link']['pitch']}
             ${calibration['sensor_kit_base_link']['velodyne_right_base_link']['yaw']}"/>
    </joint>

    <link name="velodyne_left"/>
    <joint name="velodyne_left_joint" type="fixed">
      <parent link="velodyne_left_base_link"/>
      <child link="velodyne_left"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="velodyne_right"/>
    <joint name="velodyne_right_joint" type="fixed">
      <parent link="velodyne_right_base_link"/>
      <child link="velodyne_right"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Primary IMU left Livox's internal IMU, kept under the legacy frame id
         `tamagawa/imu_link` so imu_corrector / EKF / rviz configs don't change.
         Datasheet offset (MID-360 LiDAR optical centre -> internal IMU, in the
         LiDAR's native non-inverted frame) x=-0.011, y=-0.02329, z=0.04412.
         The LiDAR's roll=π inversion is inherited by this IMU child.

         The Livox driver must publish IMU messages with frame_id = tamagawa/imu_link
         (or be remapped before imu_corrector) for the TF lookup to match. -->
    <link name="tamagawa/imu_link"/>
    <joint name="tamagawa_imu_link_joint" type="fixed">
      <parent link="velodyne_left_base_link"/>
      <child link="tamagawa/imu_link"/>
      <origin xyz="-0.011 -0.02329 0.04412" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
