<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="frame_id" default="livox_mid360"/>
  <arg name="publish_freq" default="10.0"/>
  <arg name="xfer_format" default="0"/>
  <arg name="multi_topic" default="0"/>
  <arg name="data_src" default="0"/>
  <arg name="output_data_type" default="0"/>
  <arg name="lvx_file_path" default=""/>
  <arg name="cmdline_input_bd_code" default=""/>
  <arg
    name="use_livox_tag_filter"
    default="false"
    description="Use the Livox tag filter before publishing pointcloud_before_sync. Disabled by default because the current runtime is failing to initialize ignore_tags."
  />
  <arg
    name="user_config_path"
    default="$(find-pkg-share livox_ros_driver2)/config/MID360_1.json"
  />

  <group>
    <push-ros-namespace namespace="lidar"/>

    <group>
      <push-ros-namespace namespace="top"/>
      <node pkg="livox_ros_driver2" exec="livox_ros_driver2_node" name="mid360" output="screen" if="$(var launch_driver)">
        <param name="xfer_format" value="$(var xfer_format)"/>
        <param name="multi_topic" value="$(var multi_topic)"/>
        <param name="data_src" value="$(var data_src)"/>
        <param name="publish_freq" value="$(var publish_freq)"/>
        <param name="output_data_type" value="$(var output_data_type)"/>
        <param name="frame_id" value="$(var frame_id)"/>
        <param name="lvx_file_path" value="$(var lvx_file_path)"/>
        <param name="user_config_path" value="$(var user_config_path)"/>
        <param name="cmdline_input_bd_code" value="$(var cmdline_input_bd_code)"/>
      </node>

      <include if="$(var use_livox_tag_filter)" file="$(find-pkg-share autoware_livox_tag_filter)/launch/livox_tag_filter.launch.xml">
        <arg name="input" value="livox/lidar"/>
        <arg name="output" value="pointcloud_before_sync"/>
      </include>

      <node unless="$(var use_livox_tag_filter)" pkg="topic_tools" exec="relay" name="raw_livox_pointcloud_relay" output="log">
        <param name="input_topic" value="livox/lidar"/>
        <param name="output_topic" value="pointcloud_before_sync"/>
        <param name="type" value="sensor_msgs/msg/PointCloud2"/>
        <param name="reliability" value="best_effort"/>
      </node>
    </group>

    <!-- Single-LiDAR kits do not need the concatenate-and-time-sync node.
         Relay the filtered cloud to the standard Autoware topic instead. -->
    <node pkg="topic_tools" exec="relay" name="pointcloud_relay" output="log">
      <param name="input_topic" value="top/pointcloud_before_sync"/>
      <param name="output_topic" value="concatenated/pointcloud"/>
      <param name="type" value="sensor_msgs/msg/PointCloud2"/>
      <param name="reliability" value="best_effort"/>
    </node>
  </group>
</launch>
